# MySQL connection string used by Prisma
DATABASE_URL="mysql://user:password@localhost:3306/luxefuel"

# Secret used to sign/verify JWTs. Required — the server refuses to start without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the API server listens on
PORT=5000

# Comma-separated list of origins allowed to call this API (CORS)
ALLOWED_ORIGINS=http://localhost:5173

# Cloudinary (car photo uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
